# Adresse publique du site (hreflang, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.it-rim.net

# Formulaires (contact, essai, licence, newsletter) : envoi par email via Resend.
# Mêmes noms que sur le projet Vercel actuel.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=IT-RIM <onboarding@resend.dev>
# CONTACT_TO=contact@it-rim.net

# Ou, à la place de Resend : un webhook qui reçoit chaque demande en JSON.
# CONTACT_WEBHOOK_URL=

# Google Apps Script du site actuel : chaque téléchargement est ajouté au Google Sheet.
# GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
