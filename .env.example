# Copier ce fichier en .env.local pour le developpement local (jamais commite).
# En production, ces valeurs se configurent dans Vercel > Project > Settings > Environment Variables.

# URL du fichier Mouhassib .exe version arabe (GitHub Release). Utilisee par le frontend (prefixe VITE_ obligatoire).
VITE_MOUHASSIB_DOWNLOAD_URL=https://github.com/bahe1953/it-rim/releases/download/v7.3/Mouhassib-v7.3-FINAL.exe

# URL du fichier Mouhassib .exe version francaise (GitHub Release). Meme principe que la version arabe.
VITE_MOUHASSIB_FR_DOWNLOAD_URL=https://github.com/bahe1953/it-rim/releases/download/v7.3/Mouhassib-FR-v7.3-FINAL.exe

# URL de la Google Apps Script Web App qui enregistre chaque lead dans un Google Sheet.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Cle API Resend (https://resend.com) pour l'envoi de l'email de confirmation.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse d'expedition. Sans domaine verifie sur Resend, utiliser onboarding@resend.dev.
# Une fois it-rim.net verifie sur Resend, utiliser : IT-RIM <contact@it-rim.net>
RESEND_FROM=IT-RIM <onboarding@resend.dev>

# Memes URLs de telechargement, cote serveur (utilisees dans le corps de l'email).
MOUHASSIB_DOWNLOAD_URL=https://github.com/bahe1953/it-rim/releases/download/v7.3/Mouhassib-v7.3-FINAL.exe
MOUHASSIB_FR_DOWNLOAD_URL=https://github.com/bahe1953/it-rim/releases/download/v7.3/Mouhassib-FR-v7.3-FINAL.exe
